---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const books = await getCollection('books', (e) => e.id.startsWith('en/'));
  return books.map(entry => ({
    params: { book: entry.data.id },
    props: { book: entry.data },
  }));
}

const { book } = Astro.props;

const catColors: Record<string, string> = {
  pen: 'oklch(var(--cat-l) 0.11 266)', his: 'oklch(var(--cat-l) 0.10 214)',
  poe: 'oklch(var(--cat-l) 0.10 150)', mai: 'oklch(var(--cat-l) 0.12 285)',
  men: 'oklch(var(--cat-l) 0.06 245)', eva: 'oklch(var(--cat-l) 0.13 55)',
  ato: 'oklch(var(--cat-l) 0.15 35)', pau: 'oklch(var(--cat-l) 0.15 15)',
  ger: 'oklch(var(--cat-l) 0.12 355)', apo: 'oklch(var(--cat-l) 0.13 330)',
};
const accentColor = catColors[book.category] ?? 'var(--accent)';

const siteBase = 'https://estudobiblico.pages.dev';
const canonicalUrl = `${siteBase}/en/${book.id}`;
const altLangUrl   = `${siteBase}/pt/${book.id}`;
---

<BaseLayout
  title={`${book.title} — Bible Study`}
  description={`${book.abbr} · ${book.tags.join(', ')}`}
  lang="en"
  canonicalUrl={canonicalUrl}
  altLang={{ lang: 'pt', url: altLangUrl }}
>

<style>
  .book-page {
    max-width: 780px;
    margin: 0 auto;
    padding: 60px 16px 80px;
  }
  .back-row {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 40px;
  }
  .back-link {
    font-family: var(--font-m);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color .2s;
  }
  .back-link:hover { color: var(--fg); }
  .back-actions { margin-left: auto; display: flex; gap: 6px; }
  .lang-link, .theme-link {
    font-family: var(--font-m);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .06em;
    height: 34px;
    padding: 0 12px;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--fg);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    transition: background .2s, color .2s, border-color .2s;
  }
  .lang-link:hover, .theme-link:hover { background: var(--gold); border-color: var(--gold); color: var(--on-gold); }
  .theme-link svg { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; }

  .book-page::before { content: ''; display: block; width: 64px; height: 4px; background: var(--gold); margin-bottom: 28px; }
  .mhead { display: flex; gap: 22px; align-items: flex-start; margin-bottom: 24px; padding-bottom: 22px; border-bottom: 1px solid var(--border); }
  .minitial { font-family: var(--font-d); font-size: 84px; font-weight: 700; letter-spacing: -.05em; line-height: .78; color: var(--accent); padding-top: 10px; flex-shrink: 0; }
  .mnum { font-family: var(--font-m); font-size: 11px; font-weight: 500; letter-spacing: .12em; color: var(--link); margin-bottom: 10px; text-transform: uppercase; }
  .mtitle { font-family: var(--font-d); font-size: clamp(32px, 6vw, 52px); font-weight: 700; letter-spacing: -.04em; color: var(--fg); line-height: 1; margin-bottom: 8px; }
  .mabbr { font-family: var(--font-m); font-size: 12px; color: var(--muted); }
  .mauthor { display: inline-flex; align-items: center; gap: 6px; margin-top: 12px; font-family: var(--font-b); font-size: 13px; color: var(--muted); }
  .mauthor svg { flex-shrink: 0; opacity: .7; }
  .mchars { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
  .mchar-label { font-family: var(--font-m); font-size: 10px; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin-top: 16px; display: block; }
  .mchar-tag { font-family: var(--font-b); font-size: 12px; padding: 3px 10px; border-radius: 999px; background: var(--surface); border: 1px solid var(--border); color: var(--fg); }
  .mtags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 22px; }
  .mtag { font-family: var(--font-m); font-size: 10.5px; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; background: color-mix(in srgb, var(--blue) 14%, transparent); color: var(--link); padding: 4px 10px; border-radius: 4px; }
  .msecttitle { font-family: var(--font-m); font-size: 10px; font-weight: 500; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); margin: 0 0 16px; }
  .mbody { font-family: var(--font-b); font-size: 17px; line-height: 1.8; color: var(--fg); }
  .mbody :global(p) { margin-bottom: 14px; max-width: 62ch; }
  .mbody :global(p:last-child) { margin-bottom: 0; }
  .mbody :global(strong) { color: var(--fg); font-weight: 700; background: linear-gradient(transparent 62%, color-mix(in srgb, var(--gold) 38%, transparent) 62%); }
  .mverse { font-family: var(--font-d); font-size: 20px; letter-spacing: -.01em; color: var(--fg); border-left: 3px solid var(--gold); padding: 6px 0 6px 22px; margin-top: 30px; line-height: 1.55; }
  .mverse :global(cite) { display: block; font-style: normal; font-size: 11px; font-family: var(--font-m); font-weight: 500; letter-spacing: .08em; text-transform: uppercase; margin-top: 10px; color: var(--link); }
  .translation-badge { font-family: var(--font-m); font-size: 10px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin-bottom: 18px; display: block; }
  @media (max-width: 480px) { .minitial { display: none; } }
</style>

<div class="book-page" style={`--accent:${accentColor}`}>
  <div class="back-row">
    <a href="/en" class="back-link">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
      Canon
    </a>
    <div class="back-actions">
      <button class="theme-link" onclick="toggleTheme()" aria-label="Toggle light/dark mode"><svg id="themeIcon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg></button>
      <a href={altLangUrl} class="lang-link">
      <svg style="display:none" viewBox="0 0 24 24" width="12" height="12" fill="currentColor" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
      PT
    </a>
    </div>
  </div>

  <div class="mhead">
    <div class="minitial">{book.title.charAt(0)}</div>
    <div>
      <div class="mnum">{book.num}</div>
      <div class="mtitle">{book.title}</div>
      <div class="mabbr">{book.abbr}</div>
      {book.author && (
        <div class="mauthor">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          {book.author}
        </div>
      )}
      {book.chars && book.chars.length > 0 && (
        <>
          <span class="mchar-label">Main characters</span>
          <div class="mchars">
            {book.chars.map(c => <span class="mchar-tag">{c}</span>)}
          </div>
        </>
      )}
    </div>
  </div>

  <div class="mtags">
    {book.tags.map(t => <span class="mtag">{t}</span>)}
  </div>

  <span class="translation-badge">Translation: {book.translation}</span>

  <div class="msecttitle">Context &amp; Summary</div>
  <div class="mbody" set:html={book.body} />

  {book.verse && (
    <div class="mverse" set:html={book.verse} />
  )}
</div>

</BaseLayout>
