---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const books = await getCollection('books', (e) => e.id.startsWith('pt/'));
  return books.map(entry => ({
    params: { book: entry.data.id },
    props: { book: entry.data },
  }));
}

const { book } = Astro.props;

const catColors: Record<string, string> = {
  pen: 'oklch(var(--cat-l) 0.11 266)', his: 'oklch(var(--cat-l) 0.10 214)',
  poe: 'oklch(var(--cat-l) 0.10 150)', mai: 'oklch(var(--cat-l) 0.12 285)',
  men: 'oklch(var(--cat-l) 0.06 245)', eva: 'oklch(var(--cat-l) 0.13 55)',
  ato: 'oklch(var(--cat-l) 0.15 35)', pau: 'oklch(var(--cat-l) 0.15 15)',
  ger: 'oklch(var(--cat-l) 0.12 355)', apo: 'oklch(var(--cat-l) 0.13 330)',
};
const accentColor = catColors[book.category] ?? 'var(--accent)';

const siteBase = 'https://estudobiblico.pages.dev';
const canonicalUrl = `${siteBase}/pt/${book.id}`;
const altLangUrl   = `${siteBase}/en/${book.id}`;
---

<BaseLayout
  title={`${book.title} — Estudo Bíblico`}
  description={`${book.abbr} · ${book.tags.join(', ')}`}
  lang="pt"
  canonicalUrl={canonicalUrl}
  altLang={{ lang: 'en', url: altLangUrl }}
>

<style>
  .book-page {
    max-width: 780px;
    margin: 0 auto;
    padding: 60px 16px 80px;
  }
  .back-row {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 40px;
  }
  .back-link {
    font-family: var(--font-m);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color .2s;
  }
  .back-link:hover { color: var(--accent); }
  .lang-link {
    font-family: var(--font-m);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1.5px;
    padding: 6px 14px;
    border-radius: 50px;
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    background: var(--surface);
    color: var(--accent);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
    transition: background .2s, color .2s;
  }
  .lang-link:hover { background: var(--accent); color: var(--bg); }

  .mhead { display: flex; gap: 18px; align-items: flex-start; margin-bottom: 20px; padding-bottom: 18px; border-bottom: 1px solid var(--border); }
  .minitial { font-family: var(--font-d); font-size: 56px; font-weight: 800; font-style: italic; line-height: .8; color: var(--accent); padding-top: 10px; flex-shrink: 0; }
  .mnum { font-family: var(--font-m); font-size: 10px; letter-spacing: 3.5px; color: var(--accent); opacity: .85; margin-bottom: 8px; text-transform: uppercase; }
  .mtitle { font-family: var(--font-d); font-size: 36px; font-weight: 700; letter-spacing: -0.01em; color: var(--fg); line-height: 1.1; margin-bottom: 8px; }
  .mabbr { font-family: var(--font-b); font-size: 11px; color: var(--muted); letter-spacing: 1.5px; opacity: .8; }
  .mauthor { display: inline-flex; align-items: center; gap: 6px; margin-top: 10px; font-family: var(--font-b); font-size: 11px; color: var(--muted); letter-spacing: .5px; }
  .mauthor svg { flex-shrink: 0; opacity: .7; }
  .mchars { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .mchar-label { font-family: var(--font-m); font-size: 9px; letter-spacing: 2.5px; text-transform: uppercase; color: var(--muted); opacity: .75; margin-top: 10px; display: block; }
  .mchar-tag { font-family: var(--font-b); font-size: 10px; letter-spacing: .8px; padding: 3px 11px; border-radius: 20px; background: var(--bg); border: 1px solid var(--border); color: var(--muted); }
  .mtags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 22px; }
  .mtag { font-family: var(--font-m); font-size: 9px; letter-spacing: 1.5px; text-transform: uppercase; background: color-mix(in srgb, var(--accent) 10%, transparent); color: var(--accent); padding: 4px 12px; border-radius: 20px; border: 1px solid color-mix(in srgb, var(--accent) 18%, transparent); }
  .msecttitle { font-family: var(--font-m); font-size: 9px; letter-spacing: 4px; text-transform: uppercase; color: var(--muted); opacity: .8; margin: 0 0 14px; }
  .mbody { font-family: var(--font-b); font-size: 17px; line-height: 1.82; color: var(--fg); text-align: justify; hyphens: auto; }
  .mbody :global(p) { margin-bottom: 14px; }
  .mbody :global(p:last-child) { margin-bottom: 0; }
  .mbody :global(strong) { color: var(--accent); font-weight: 600; }
  .mverse { font-family: var(--font-d); font-style: italic; font-size: 17px; color: var(--muted); border-left: 3px solid var(--accent); padding: 12px 0 12px 20px; margin-top: 24px; line-height: 1.7; background: color-mix(in srgb, var(--accent) 4%, transparent); border-radius: 0 8px 8px 0; }
  .mverse :global(cite) { display: block; font-style: normal; font-size: 11px; font-family: var(--font-m); letter-spacing: 1.5px; opacity: .8; margin-top: 8px; color: var(--accent); }
  .translation-badge { font-family: var(--font-m); font-size: 9px; letter-spacing: 2px; text-transform: uppercase; color: var(--muted); opacity: .7; margin-bottom: 18px; display: block; }
</style>

<div class="book-page" style={`--accent:${accentColor}`}>
  <div class="back-row">
    <a href="/pt" class="back-link">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
      Cânon
    </a>
    <a href={altLangUrl} class="lang-link">
      <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
      EN
    </a>
  </div>

  <div class="mhead">
    <div class="minitial">{book.title.charAt(0)}</div>
    <div>
      <div class="mnum">{book.num}</div>
      <div class="mtitle">{book.title}</div>
      <div class="mabbr">{book.abbr}</div>
      {book.author && (
        <div class="mauthor">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          {book.author}
        </div>
      )}
      {book.chars && book.chars.length > 0 && (
        <>
          <span class="mchar-label">Personagens principais</span>
          <div class="mchars">
            {book.chars.map(c => <span class="mchar-tag">{c}</span>)}
          </div>
        </>
      )}
    </div>
  </div>

  <div class="mtags">
    {book.tags.map(t => <span class="mtag">{t}</span>)}
  </div>

  <span class="translation-badge">Tradução: {book.translation}</span>

  <div class="msecttitle">Contexto &amp; Resumo</div>
  <div class="mbody" set:html={book.body} />

  {book.verse && (
    <div class="mverse" set:html={book.verse} />
  )}
</div>

</BaseLayout>
