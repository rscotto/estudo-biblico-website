---
export interface Props {
  title: string;
  description?: string;
  lang: 'pt' | 'en';
  canonicalUrl?: string;
  altLang?: { lang: string; url: string };
}

const { title, description, lang, canonicalUrl, altLang } = Astro.props;
const htmlLang = lang === 'en' ? 'en' : 'pt-BR';
---

<!DOCTYPE html>
<html lang={htmlLang}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
{description && <meta name="description" content={description} />}
{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
{altLang && <link rel="alternate" hreflang={altLang.lang} href={altLang.url} />}
<link rel="alternate" hreflang={lang} href={canonicalUrl} />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
<style is:global>
/* ── TOKENS — Azul #0F1B2A · Azul-destaque #4A90D9 · Offwhite #F1EADA · Ouro #FFA400 ── */
:root {
  --navy:    #0F1B2A;
  --blue:    #4A90D9;
  --paper:   #F1EADA;
  --gold:    #FFA400;

  /* claro (papel) */
  --bg:      #F1EADA;
  --surface: #F8F4E9;
  --fg:      #0F1B2A;
  --muted:   #4D5967;
  --border:  #D6CDB4;
  --accent:  #8A5400;      /* ouro escurecido: texto/ícones sobre papel (AA) */
  --link:    #1D5FAE;      /* azul-destaque escurecido p/ texto sobre papel */
  --on-gold: #0F1B2A;

  --pen-h:266; --pen-c:0.11;
  --his-h:214; --his-c:0.10;
  --poe-h:150; --poe-c:0.10;
  --mai-h:285; --mai-c:0.12;
  --men-h:245; --men-c:0.06;
  --eva-h:55;  --eva-c:0.13;
  --ato-h:35;  --ato-c:0.15;
  --pau-h:15;  --pau-c:0.15;
  --ger-h:355; --ger-c:0.12;
  --apo-h:330; --apo-c:0.13;
  --cat-l:50%;

  --font-d:'Space Grotesk',system-ui,sans-serif;
  --font-b:'Plus Jakarta Sans',system-ui,sans-serif;
  --font-m:'JetBrains Mono',ui-monospace,monospace;
  --ease:cubic-bezier(.2,0,.2,1);
  --t:.18s var(--ease);
}
[data-theme="dark"] {
  --bg:      #0F1B2A;
  --surface: #162738;
  --fg:      #F1EADA;
  --muted:   #9DAABA;
  --border:  #26394E;
  --accent:  #FFA400;
  --link:    #4A90D9;
  --cat-l:   72%;
}

/* ── RESET ── */
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
*:focus-visible{outline:2px solid var(--link);outline-offset:3px;border-radius:3px;}
html{scroll-behavior:smooth;}
body{
  background:var(--bg); color:var(--fg);
  font-family:var(--font-b); font-size:16px; line-height:1.65;
  min-height:100dvh; padding-bottom:80px;
  -webkit-font-smoothing:antialiased;
  transition:background var(--t),color var(--t);
}
::selection{background:var(--gold);color:var(--on-gold);}

/* ── TOOLBAR ── */
.toolbar{
  position:fixed; top:0; left:0; right:0;
  display:flex; align-items:center; gap:6px; padding:10px 24px;
  background:color-mix(in srgb,var(--bg) 88%,transparent);
  backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px);
  border-bottom:1px solid var(--border);
  z-index:9000; transition:background var(--t),border-color var(--t);
}
.brand{
  display:flex; align-items:center; gap:10px; margin-right:auto;
  font-family:var(--font-d); font-weight:700; font-size:15px; letter-spacing:-.01em;
  color:var(--fg); text-decoration:none;
}
.brand i{width:10px;height:10px;background:var(--gold);display:block;border-radius:2px;}
.tbtn{
  display:flex; align-items:center; gap:5px; height:34px;
  padding:0 12px; background:none; border:1px solid transparent;
  color:var(--muted); font-family:var(--font-m); font-size:12px;
  font-weight:500; letter-spacing:.06em; cursor:pointer; border-radius:6px;
  text-decoration:none; white-space:nowrap;
  transition:color var(--t),border-color var(--t),background var(--t);
}
.tbtn:hover{color:var(--fg);border-color:var(--border);}
.tbtn svg{width:16px;height:16px;flex-shrink:0;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;}
.tbtn-lang{color:var(--fg);border-color:var(--border);font-weight:700;}
.tbtn-lang:hover{background:var(--gold);border-color:var(--gold);color:var(--on-gold);}

/* ── LAYOUT CONTAINER ── */
.main{min-width:0;max-width:1180px;margin:0 auto;padding:56px 24px 0;}

/* ── HERO ── */
.header{padding:72px 0 40px;max-width:900px;}
.header-rule,.header-rule-accent{display:none;}
.eyebrow{
  display:inline-flex;align-items:center;gap:10px;
  font-family:var(--font-m);font-size:12px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;
  color:var(--link);margin-bottom:22px;
}
.eyebrow::before{content:'';width:28px;height:2px;background:var(--gold);}
.masthead,h1{
  font-family:var(--font-d);font-size:clamp(42px,8.2vw,104px);font-weight:700;
  line-height:.94;letter-spacing:-.045em;color:var(--fg);margin-bottom:24px;
  text-wrap:balance;
}
.masthead em,h1 em{font-style:normal;color:var(--gold);}
[data-theme="light"] .masthead em,[data-theme="light"] h1 em{color:var(--accent);}
.subline{font-size:clamp(16px,1.6vw,19px);color:var(--muted);max-width:56ch;line-height:1.6;}

/* ── SPINE (assinatura): uma faixa por livro, largura = nº de capítulos ── */
.spine{margin:8px 0 56px;}
.spine-bar{display:flex;gap:2px;height:76px;align-items:stretch;}
.sp{
  flex:var(--w) 1 0; min-width:2px; padding:0; border:0; cursor:pointer;
  background:var(--cc); border-radius:2px;
  transform-origin:bottom; animation:grow .7s var(--ease) both;
  animation-delay:calc(var(--i) * 9ms);
  transition:transform var(--t),filter var(--t),opacity var(--t);
}
.sp-nt{margin-left:12px;}
.sp:hover{transform:scaleY(1.14);filter:brightness(1.18);}
.spine-bar:hover .sp:not(:hover){opacity:.55;}
@keyframes grow{from{transform:scaleY(.08);opacity:0}to{transform:none;opacity:1}}
.spine-scale{display:flex;gap:12px;margin-top:10px;font-family:var(--font-m);font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);}
.spine-scale span{border-top:1px solid var(--border);padding-top:8px;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.spine-read{margin-top:14px;min-height:26px;font-family:var(--font-m);font-size:13px;color:var(--muted);}
.spine-read b{font-family:var(--font-d);font-size:18px;font-weight:600;color:var(--fg);margin-right:10px;letter-spacing:-.01em;}
.spine-read span{color:var(--link);}

/* ── TESTAMENT DIVIDER ── */
.tdiv{display:flex;align-items:baseline;gap:18px;margin:64px 0 8px;padding-bottom:14px;border-bottom:2px solid var(--fg);}
.tline{display:none;}
.tlabel{font-family:var(--font-d);font-size:clamp(26px,4vw,40px);font-weight:700;letter-spacing:-.03em;color:var(--fg);white-space:nowrap;}
.tcount{font-family:var(--font-m);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--link);margin-left:auto;}

/* ── SECTION LABEL ── */
.slabel,.slabel-link{
  display:flex; align-items:center; gap:10px; font-family:var(--font-m); font-size:12px; font-weight:500;
  letter-spacing:.08em; text-transform:uppercase; color:var(--muted);
  text-decoration:none; margin:28px 0 10px; transition:color var(--t);
}
.slabel-link::after{content:'→';margin-left:auto;color:var(--link);opacity:0;transform:translateX(-4px);transition:opacity var(--t),transform var(--t);}
.slabel-link:hover{color:var(--fg);}
.slabel-link:hover::after,.slabel-link:focus-visible::after{opacity:1;transform:none;}

/* ── GRID ── */
.ptable{max-width:1180px;margin:0 auto;}
.g{display:grid;gap:6px;margin-bottom:4px;}
.r5 {grid-template-columns:repeat(5,minmax(0,1fr));}
.r12{grid-template-columns:repeat(12,minmax(0,1fr));}
.r4 {grid-template-columns:repeat(4,minmax(0,1fr));}
.r1 {grid-template-columns:minmax(0,1fr);}
.r13{grid-template-columns:repeat(13,minmax(0,1fr));}
.r8 {grid-template-columns:repeat(8,minmax(0,1fr));}

/* ── CELL ── */
.cell{
  position:relative; display:flex; flex-direction:column;
  align-items:flex-start; justify-content:space-between;
  padding:12px 8px 8px; aspect-ratio:1/1.12;
  background:var(--surface); border:1px solid var(--border);
  border-radius:6px; cursor:pointer; text-align:left; overflow:hidden;
  transition:transform var(--t),border-color var(--t),background var(--t),box-shadow var(--t);
  -webkit-tap-highlight-color:transparent;
  font:inherit; color:inherit;
}
.cell::before{content:'';position:absolute;left:0;right:0;top:0;height:3px;background:var(--cc,var(--border));transition:height var(--t);}
.cell:hover{transform:translateY(-3px);border-color:var(--cc,var(--muted));box-shadow:0 10px 24px -10px color-mix(in srgb,var(--cc,#000) 55%,transparent);z-index:10;}
.cell:hover::before{height:6px;}
.cell:focus-visible{outline:2px solid var(--link);outline-offset:2px;}
.cell:active{transform:none;}

.pen{--cc:oklch(var(--cat-l) var(--pen-c) var(--pen-h));}
.his{--cc:oklch(var(--cat-l) var(--his-c) var(--his-h));}
.poe{--cc:oklch(var(--cat-l) var(--poe-c) var(--poe-h));}
.mai{--cc:oklch(var(--cat-l) var(--mai-c) var(--mai-h));}
.men{--cc:oklch(var(--cat-l) var(--men-c) var(--men-h));}
.eva{--cc:oklch(var(--cat-l) var(--eva-c) var(--eva-h));}
.ato{--cc:oklch(var(--cat-l) var(--ato-c) var(--ato-h));}
.pau{--cc:oklch(var(--cat-l) var(--pau-c) var(--pau-h));}
.ger{--cc:oklch(var(--cat-l) var(--ger-c) var(--ger-h));}
.apo{--cc:oklch(var(--cat-l) var(--apo-c) var(--apo-h));}

.cn{font-family:var(--font-m);font-size:clamp(8px,.95vw,11px);font-weight:500;color:var(--muted);line-height:1;}
.ca{font-family:var(--font-d);font-size:clamp(12px,1.9vw,24px);font-weight:700;letter-spacing:-.03em;line-height:1;color:var(--fg);}
.cname{font-family:var(--font-b);font-size:clamp(8px,.95vw,12px);font-weight:500;color:var(--muted);line-height:1.2;word-break:break-word;}

/* grupos com poucas colunas: células largas ficariam gigantes com proporção fixa */
.r4 .cell,.r5 .cell,.r8 .cell{aspect-ratio:auto;min-height:104px;}

/* ── LEGEND ── */
.legend{
  display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr));
  gap:8px; margin-top:20px;
  max-width:1180px; margin-left:auto; margin-right:auto;
}
.li{display:flex;align-items:center;gap:12px;padding:12px 14px;border:1px solid var(--border);border-radius:6px;background:var(--surface);}
.lbar{width:4px;height:30px;border-radius:2px;flex-shrink:0;background:var(--cc,var(--accent));}
.lcat{font-family:var(--font-m);font-size:10px;font-weight:500;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);display:block;margin-bottom:2px;}
.lname{font-family:var(--font-d);font-size:15px;font-weight:600;letter-spacing:-.01em;color:var(--fg);display:block;}
.lcount{font-family:var(--font-m);font-size:12px;font-weight:700;color:var(--link);margin-left:auto;padding-left:8px;flex-shrink:0;}

/* ── MODAL ── */
.overlay{display:none;position:fixed;inset:0;z-index:10000;background:rgba(15,27,42,.6);backdrop-filter:blur(4px);align-items:center;justify-content:center;padding:16px;}
.overlay.open{display:flex;animation:fadeIn .2s ease;}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
@keyframes slideUp{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:none}}

.modal{
  background:var(--surface); border:1px solid var(--border);
  border-radius:12px; max-width:720px; width:100%;
  max-height:90vh; overflow-y:auto; position:relative;
  box-shadow:0 30px 80px -20px rgba(0,0,0,.45);
  animation:slideUp .24s var(--ease);
  scrollbar-width:thin; scrollbar-color:var(--border) transparent;
}
.modal::before{content:'';position:sticky;top:0;display:block;height:4px;background:var(--gold);z-index:2;}

.mclose{
  position:absolute; top:18px; right:16px;
  width:34px; height:34px; display:flex; align-items:center; justify-content:center;
  background:var(--surface); border:1px solid var(--border); border-radius:6px;
  cursor:pointer; color:var(--muted);
  transition:background var(--t),color var(--t),border-color var(--t); z-index:3;
}
.mclose:hover{background:var(--gold);color:var(--on-gold);border-color:var(--gold);}
.mclose svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;}

.modal-inner{padding:20px 48px 48px;}
.mhead{display:flex;gap:22px;align-items:flex-start;margin-bottom:26px;padding-bottom:24px;border-bottom:1px solid var(--border);}
.minitial{font-family:var(--font-d);font-size:84px;line-height:.78;font-weight:700;color:var(--mcc,var(--accent));padding-top:10px;flex-shrink:0;letter-spacing:-.05em;}
.mhead-main{min-width:0;padding-right:36px;}
.mnum{font-family:var(--font-m);font-size:11px;font-weight:500;letter-spacing:.12em;text-transform:uppercase;color:var(--link);margin-bottom:10px;}
.mtitle{font-family:var(--font-d);font-size:clamp(30px,5vw,48px);font-weight:700;letter-spacing:-.04em;line-height:1;color:var(--fg);margin-bottom:8px;}
.mabbr{font-family:var(--font-m);font-size:12px;color:var(--muted);letter-spacing:.02em;}
.mauthor{display:none;align-items:center;gap:6px;margin-top:12px;font-size:13px;color:var(--muted);}
.mauthor svg{width:13px;height:13px;flex-shrink:0;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;}
.mchar-label{font-family:var(--font-m);font-size:10px;font-weight:500;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);display:block;margin-top:16px;}
.mchars{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px;}
.mchar-tag{font-size:12px;padding:3px 10px;border-radius:999px;background:var(--bg);border:1px solid var(--border);color:var(--fg);}
.mtags{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:22px;}
.mtag{font-family:var(--font-m);font-size:10.5px;font-weight:500;letter-spacing:.06em;text-transform:uppercase;padding:4px 10px;border-radius:4px;background:color-mix(in srgb,var(--blue) 14%,transparent);color:var(--link);}
.msecttitle{font-family:var(--font-m);font-size:10px;font-weight:500;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);margin:0 0 16px;}
.mbody{font-size:16px;line-height:1.8;color:var(--fg);}
.mbody p{margin-bottom:14px;max-width:62ch;}
.mbody p:last-child{margin-bottom:0;}
.mbody strong{color:var(--fg);font-weight:700;background:linear-gradient(transparent 62%,color-mix(in srgb,var(--gold) 38%,transparent) 62%);}
.mverse{display:none;font-family:var(--font-d);font-size:19px;line-height:1.55;letter-spacing:-.01em;color:var(--fg);border-left:3px solid var(--gold);padding:6px 0 6px 22px;margin-top:30px;}
.mverse cite{display:block;font-style:normal;font-family:var(--font-m);font-size:11px;font-weight:500;letter-spacing:.08em;text-transform:uppercase;color:var(--link);margin-top:10px;}

/* ── RESPONSIVE ── */
@media(max-width:900px){
  .main{padding:56px 16px 0;}
  .header{padding:48px 0 28px;}
  .modal-inner{padding:20px 26px 34px;}
}
@media(max-width:700px){
  .r12{grid-template-columns:repeat(6,minmax(0,1fr));}
  .r13{grid-template-columns:repeat(7,minmax(0,1fr));}
  .r8 {grid-template-columns:repeat(4,minmax(0,1fr));}
  .cell{aspect-ratio:1/1.2;padding:10px 6px 6px;}
  .cname{font-size:clamp(7px,1.9vw,10px);}
  .ca{font-size:clamp(11px,3vw,18px);}
  .spine-bar{height:56px;}
  .sp-nt{margin-left:6px;}
}
@media(max-width:480px){
  .toolbar{padding:8px 14px;}
  .cn {display:none;}
  .legend{grid-template-columns:repeat(2,minmax(0,1fr));}
  .li{padding:10px;gap:8px;}
  .modal-inner{padding:18px 18px 26px;}
  .minitial{display:none;}
  .mhead-main{padding-right:34px;}
  .mbody{font-size:15px;}
}
@media(prefers-reduced-motion:reduce){
  *,*::before,*::after{animation:none !important;transition:none !important;}
  html{scroll-behavior:auto;}
}
</style>
<script is:inline>
(function(){
  var saved=null;
  try{saved=localStorage.getItem('ebTheme');}catch(e){}
  var sys=window.matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light';
  document.documentElement.setAttribute('data-theme',saved||sys);
})();
window.toggleTheme=function(){
  var el=document.documentElement;
  var next=el.getAttribute('data-theme')==='dark'?'light':'dark';
  el.setAttribute('data-theme',next);
  try{localStorage.setItem('ebTheme',next);}catch(e){}
  var icon=document.getElementById('themeIcon');
  if(icon){
    icon.innerHTML=next==='dark'
      ?'<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>'
      :'<circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>';
  }
};
</script>
</head>
<body>
  <slot />
</body>
</html>
